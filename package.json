{
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/staging-aware-build.ts",
    "start": "next start",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "test": "pnpm prettier:check",
    "test:unit": "tsx --env-file=.env.test --test --experimental-test-module-mocks \"tests/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/run-seed-safely.ts",
    "production:db:check": "tsx scripts/check-production-db-readiness.ts",
    "production:build": "npm run production:db:check && npx prisma migrate deploy && next build",
    "staging:bootstrap": "tsx scripts/staging-bootstrap.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@next/env": "15.6.0-canary.61",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "geist": "^1.3.1",
    "next": "15.6.0-canary.61",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.0.14",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.23.1",
    "typescript": "5.8.2"
  }
}
