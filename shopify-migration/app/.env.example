# Plantilla de variables de la función. SOLO nombres y placeholders.
# Los valores reales se cargan en el gestor de secretos del hosting (paso de
# la dueña). Nunca los pegues en el repo, en un chat ni en un ticket.
# La función NO lee archivos .env: el hosting inyecta las variables.
# Con cualquier valor "REEMPLAZAR..." la función se niega a arrancar.

# --- Secretos (obligatorios) ---
SHOPIFY_API_KEY=REEMPLAZAR-client-id
SHOPIFY_API_SECRET=REEMPLAZAR-client-secret
# Solo con ADMIN_TOKEN_SOURCE=env (token offline de UNA tienda, R3b):
SHOPIFY_ADMIN_ACCESS_TOKEN=REEMPLAZAR-token-offline-de-admin

# --- Tiendas y proxy ---
# Dominios *.myshopify.com permitidos, separados por coma (con token "env": uno solo).
ALLOWED_SHOPS=REEMPLAZAR-tienda.myshopify.com
ALLOWED_PATH_PREFIXES=/apps/radaelli

# --- Token de Admin (R3) ---
# env = token offline guardado como secreto | client_credentials = misma organización
ADMIN_TOKEN_SOURCE=env

# --- Opcionales (valores por defecto) ---
SHOPIFY_API_VERSION=2026-07
PROXY_MAX_SKEW_SEC=300
SESSION_TOKEN_LEEWAY_SEC=5
REQUIRE_CSRF_HEADER=true
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_MINUTE=30
# set_empty (metafieldsSet "[]" + CAS) | delete (metafieldsDelete, sin CAS) -- GO/NO-GO 10
EMPTY_LIST_STRATEGY=set_empty
PORT=8080
HOST=0.0.0.0
