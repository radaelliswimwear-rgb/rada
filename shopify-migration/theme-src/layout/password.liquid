<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%} Mismo fondo suave que pinta .password-main (barra del navegador en mobile). {%- endcomment -%}
    <meta name="theme-color" content="{{ settings.color_background_soft | default: '#f7f4ef' }}">
    <meta name="robots" content="noindex">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {%- comment -%}
      Fase 03B -- layout propio de la página de contraseña (tienda
      protegida). Solo carga lo que usa esta página: tokens de marca,
      base, botones y formularios. Sin header, footer, carrito ni JS del
      theme: la clienta todavía no puede comprar. Ver
      theme/03B-store-foundation-report.md.
    {%- endcomment -%}
    {{ content_for_header }}

    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-button.css' | asset_url | stylesheet_tag }}
    {{ 'component-form.css' | asset_url | stylesheet_tag }}
    {{ 'section-password.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-password">
    <a class="visually-hidden skip-link" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
