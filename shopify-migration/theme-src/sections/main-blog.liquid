{%- comment -%}
  Foundation de listado de blog. Equivalente a /blog (BlogCard,
  blogRepository.listAll() -- ver react-to-liquid-map.md).
{%- endcomment -%}
<div class="page-width section main-blog">
  <h1>{{ blog.title }}</h1>

  {%- if blog.articles.size > 0 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a class="card main-blog__card" href="{{ article.url }}">
          <div class="card__media media media--landscape">
            {%- render 'image', image: article.image, alt: article.title, sizes: '(min-width: 768px) 33vw, 100vw' -%}
          </div>
          <h2 class="h4">{{ article.title }}</h2>
          <p class="text-body-sm">{{ article.excerpt | strip_html | truncate: 140 }}</p>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="state-empty">{{ 'blogs.general.no_articles' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main blog",
  "settings": []
}
{% endschema %}
