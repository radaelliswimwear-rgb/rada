{%- comment -%}
  Productos destacados real (Fase 02E). EXACT: réplica de
  components/home/featured-products.tsx -- eyebrow "Lo más nuevo" + h2
  "Productos destacados", `id="productos"` (el CTA del Hero y de
  PromoBanner saltan acá), carrusel de productos compartido.

  Divergencia documentada: el real usa catalogRepository.listFeatured()
  (flag `featured` propio, sin equivalente nativo en Shopify) -- acá es
  un `collection` picker (Daniela gestiona una colección "Destacados" en
  el Admin), sin handle hardcodeado.
{%- endcomment -%}
{%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
  <section id="productos" class="section-featured-products">
    <div class="page-width">
      <div class="section-featured-products__heading">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-featured-products__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-featured-products__title">{{ section.settings.heading }}</h2>
      </div>
      {%- render 'product-carousel', collection: section.settings.collection, limit: section.settings.limit -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño superior",
      "default": "Lo más nuevo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Productos destacados"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Máximo de productos",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Productos destacados"
    }
  ]
}
{% endschema %}
