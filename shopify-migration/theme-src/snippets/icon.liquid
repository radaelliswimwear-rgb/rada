{%- comment -%}
  Snippet foundation de iconos.
  Uso: {% render 'icon', name: 'search' %}
       {% render 'icon', name: 'search', size: 'sm' %} (sm/md/lg, ver
       assets/component-media.css .icon--sm/--md/--lg; default = md)

  Fase 02A: search/cart/account/heart/chevron-right, suficiente para que
  header/footer placeholder y snippets foundation funcionen sin texto
  plano. Fase 02C: + menu/close/back, para el header y el drawer mobile
  reales. Fase 02D: + instagram/facebook/tiktok/whatsapp, réplica exacta
  de components/icons/social-icons.tsx (paths/viewBox idénticos) para el
  footer y el bloque de contacto reales. El resto del set real de
  Heroicons usado hoy (ver react-to-liquid-map.md) se agrega en las fases
  que realmente lo necesiten -- no se copian todos aquí solo porque el
  blueprint los lista.

  NO usa una librería externa -- SVG inline, coherente con "sin
  dependencias grandes" de esta fase. currentColor hereda el color de
  texto del elemento contenedor (.icon, ver component-media.css).
{%- endcomment -%}
{%- liquid
  assign icon_class = 'icon'
  if size
    assign icon_class = icon_class | append: ' icon--' | append: size
  endif
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
    </svg>
  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6"></path>
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="18" cy="21" r="1"></circle>
    </svg>
  {%- when 'account' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
    </svg>
  {%- when 'heart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M12 20s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z"></path>
    </svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <polyline points="9 6 15 12 9 18"></polyline>
    </svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <polyline points="15 6 9 12 15 18"></polyline>
    </svg>
  {%- comment -%} Fase 02H: EXACT paths de Heroicons 24/outline usados por la PDP real (ArrowLeft/ArrowRight, MagnifyingGlassPlus/Minus, Plus). {%- endcomment -%}
  {%- when 'arrow-left' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
    </svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
    </svg>
  {%- when 'zoom-in' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6"></path>
    </svg>
  {%- when 'zoom-out' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM13.5 10.5h-6"></path>
    </svg>
  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 4.5v15m7.5-7.5h-15"></path>
    </svg>
  {%- comment -%} Fase 02I: EXACT Heroicons 24/outline del carrito real (MinusIcon, ShoppingBagIcon). {%- endcomment -%}
  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M5 12h14"></path>
    </svg>
  {%- when 'bag' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
    </svg>
  {%- comment -%} Fase 02K: EXACT Heroicons 24/outline TrashIcon (wishlist-item-card.tsx). {%- endcomment -%}
  {%- when 'trash' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
    </svg>
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  {%- when 'back' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true" focusable="false">
      <polyline points="15 6 9 12 15 18"></polyline>
    </svg>
  {%- when 'instagram' -%}
    {%- comment -%} EXACT: components/icons/social-icons.tsx InstagramIcon {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
    </svg>
  {%- when 'facebook' -%}
    {%- comment -%} EXACT: components/icons/social-icons.tsx FacebookIcon {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M13.5 21v-7.5h2.52l.38-2.93H13.5V8.7c0-.85.24-1.43 1.45-1.43h1.55V4.66c-.27-.04-1.19-.11-2.26-.11-2.24 0-3.77 1.37-3.77 3.87v2.16H8.09v2.93h2.38V21h3.03Z"></path>
    </svg>
  {%- when 'tiktok' -%}
    {%- comment -%} EXACT: components/icons/social-icons.tsx TiktokIcon {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.58h-3.03v13.44c0 1.5-1.22 2.72-2.72 2.72a2.72 2.72 0 0 1 0-5.44c.28 0 .55.04.8.12V9.94a5.75 5.75 0 0 0-.8-.06 5.75 5.75 0 1 0 5.75 5.75V9.01a7.35 7.35 0 0 0 4.3 1.38V7.36c-1.03 0-1.99-.32-2.9-1.02Z"></path>
    </svg>
  {%- when 'whatsapp' -%}
    {%- comment -%} EXACT: components/icons/social-icons.tsx WhatsappIcon {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.41-1.42a9.87 9.87 0 0 0 4.63 1.18h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.06h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.16 8.16 0 0 1-1.25-4.3c0-4.53 3.7-8.22 8.24-8.22 2.2 0 4.27.86 5.82 2.42a8.15 8.15 0 0 1 2.41 5.81c0 4.53-3.7 8.22-8.24 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.48-.01s-.43.06-.66.31c-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.57c.12.16 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.1-.23-.16-.48-.28Z"></path>
    </svg>
{%- endcase -%}
