COMPANY_NAME="LAGO"
# SITE_NAME ya no se lee del entorno (SEO técnico, septiembre 2026): el
# nombre de marca es una única fuente de verdad en lib/seo/site.ts, para
# que <title>/OpenGraph/Twitter nunca puedan desincronizarse del JSON-LD.
DATABASE_URL="postgresql://user:password@localhost:5432/lago?schema=public"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_PAYMENT_PROVIDER="stripe"
# "stripe" es un proveedor SIMULADO (nunca cobra ni verifica dinero real).
# Deshabilitado por defecto en esta plantilla — sin esta bandera en "true",
# el sitio NO deja procesar ningún pago con el simulado, en ningún entorno.
# Poné "true" solo en un .env.local de un entorno de pruebas aislado propio
# (nunca en un despliegue público real, y nunca alcanza para habilitarlo en
# una producción identificada de Vercel — ver lib/payments/guard-real-payments.ts).
PAYMENTS_TEST_MODE="false"
WOMPI_BASE_URL="https://sandbox.wompi.co/v1"
# "true" mientras WOMPI_PUBLIC_KEY/PRIVATE_KEY sean pub_test_/prv_test_ (muestra
# las tarjetas de prueba en el checkout) — poner en "false" o quitar al pasar a
# llaves pub_prod_/prv_prod_, para no mostrarle tarjetas de prueba a una clienta real.
NEXT_PUBLIC_WOMPI_SANDBOX="true"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# APP_ENVIRONMENT clasifica la EJECUCIÓN de la app (no la base de datos,
# eso es DATABASE_ENV_LABEL -- ver scripts/lib/load-safe-env.ts). Valores
# admitidos: development | staging | production | test. Es la fuente de
# verdad explícita para decisiones sensibles (p. ej. el guard de pagos
# reales en lib/payments/guard-real-payments.ts) -- deliberadamente NO se
# infiere de NODE_ENV, porque `next start` deja NODE_ENV=production incluso
# en builds locales/E2E. Requerida en staging/production; en development se
# puede omitir para builds/tests puntuales que no dependan de ella.
APP_ENVIRONMENT="development"

# APP_BASE_URL es la URL pública canónica de la app (ver lib/utils.ts,
# getAppBaseUrl()) -- propia del proyecto, portable a cualquier hosting
# (Vercel, Railway, Render, Fly.io, AWS...), nunca depende de una variable
# exclusiva de una plataforma. Se usa para el redirect-url del Checkout Web
# alojado de Wompi (<APP_BASE_URL>/checkout/wompi/retorno) y para los links
# absolutos de todos los emails transaccionales (verificación, recuperación
# de contraseña, confirmación de pedido, políticas de envío/devoluciones).
# Sin ella: en development/test cae a http://localhost:3000; en
# staging/production, falla ruidosamente en vez de asumir localhost en
# silencio -- así nunca se le manda a una clienta real un link roto.
# Durante un E2E con túnel público, se puede sobreescribir temporalmente vía
# process.env (ej. APP_BASE_URL=https://<tunnel> npm run start) sin editar
# este archivo ni .env.local.
APP_BASE_URL="http://localhost:3000"
# Secreto propio (generá uno vos, ej: openssl rand -hex 32) para el cron que
# libera stock reservado de pagos con tarjeta nunca confirmados (ver
# app/api/cron/release-stale-payments y vercel.json) — Vercel lo manda solo
# como header Authorization al disparar el cron si esta variable está
# configurada en el proyecto.
CRON_SECRET=""

# Email transaccional (ver lib/email/send.ts) — sin RESEND_API_KEY, los
# correos (verificación, bienvenida, pedido nuevo, etc.) solo se loguean en
# la consola del servidor en vez de enviarse de verdad. Crear cuenta en
# resend.com, verificar un dominio, y pegar la API key acá.
RESEND_API_KEY=""
# Remitente que ve la clienta — necesita el dominio verificado en Resend
# (ver reporte de la sección de emails). Mientras no esté verificado, dejar
# vacío: cae solo a "Radaelli Swimwear <onboarding@resend.dev>".
EMAIL_FROM=""

# Correos que reciben la notificación de cada compra nueva y demás avisos
# administrativos (ver lib/email/admin-recipients.ts — único lugar donde
# viven estas direcciones). Si se dejan vacíos, el sistema usa las
# direcciones oficiales ya conocidas como valor por defecto.
ADMIN_NOTIFICATION_EMAIL_1=""
ADMIN_NOTIFICATION_EMAIL_2=""

# ============================================================
# Fase 2A de analytics (GA4/Meta) -- ver lib/analytics/**
# ============================================================
# Interruptor maestro: TODA la instrumentación de esta fase queda apagada
# (ni GA4, ni Meta Pixel, ni Meta CAPI, ni el almacén first-party propio)
# hasta que esto sea EXACTAMENTE "true". Cualquier otro valor (vacío,
# "false", "1", ausente) = apagado. Ver lib/analytics/feature-flags.ts.
ANALYTICS_RUNTIME_ENABLED="false"
# Sub-flag: scripts de terceros en el navegador (gtag.js, fbevents.js). Solo
# importa si ANALYTICS_RUNTIME_ENABLED="true".
ANALYTICS_BROWSER_ENABLED="false"
# Sub-flag: entrega server-side a proveedores externos (Meta CAPI hoy). Solo
# importa si ANALYTICS_RUNTIME_ENABLED="true".
ANALYTICS_SERVER_DELIVERY_ENABLED="false"

# IDs públicos (seguros de exponer en el navegador, Next.js los incluye en
# el bundle de cliente). Ya creados manualmente -- ver reporte de esta fase.
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-P4CEL2LM5E"
NEXT_PUBLIC_META_PIXEL_ID="1415307240666037"

# Secretos server-side PENDIENTES -- todavía no existen (no se generaron en
# esta fase, ver reporte). Sin estos, los adapters server
# (lib/analytics/adapters/meta-capi.ts,
# lib/analytics/adapters/ga4-measurement-protocol.ts) responden "skipped"
# sin intentar ningún request real, nunca fallan de forma insegura.
META_CAPI_ACCESS_TOKEN=""
GA4_MEASUREMENT_PROTOCOL_API_SECRET=""
