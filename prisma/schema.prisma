generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(USER)
  addresses    Address[]
  orders       Order[]
  wishlist     Wishlist[]
  carts        Cart[]
  createdAt    DateTime   @default(now())

  // Sesion real de servidor (Sprint 26): reemplaza el localStorage
  // client-only anterior. emailVerifiedAt null = todavia no confirmo su
  // correo; no bloquea el login, solo algunos flujos sensibles la exigen
  // (ver lib/auth/authorize.ts).
  emailVerifiedAt    DateTime?
  sessions           Session[]
  verificationTokens VerificationToken[]

  backInStockRequests BackInStockRequest[]
}

enum UserRole {
  USER
  ADMIN
}

// Token opaco (no el valor real: se guarda su hash SHA-256) en una cookie
// HttpOnly+Secure+SameSite=Lax en el navegador — ver lib/auth/session.ts.
// Una fila por sesion activa; cerrar sesion borra la fila (no solo la
// cookie), asi una sesion robada deja de servir apenas se invalida acá.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Reemplaza lib/auth/reset-tokens-storage.ts (localStorage, inseguro): el
// valor real del token nunca se guarda, solo su hash — igual que una
// contraseña, para que una fuga de la base de datos no entregue tokens
// utilizables. usedAt marca un token ya consumido (de un solo uso);
// expiresAt lo vence solo. Ambos flujos (verificar correo, recuperar
// contraseña) comparten esta misma tabla via `type`.
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

// Rate limiting contra fuerza bruta en login/registro/recuperacion (Sprint
// 26) — ventana deslizante simple contada en Postgres, sin servicio externo
// nuevo. Una fila por intento; lib/auth/rate-limit.ts cuenta cuantas filas
// recientes hay para un email+accion (o ip+accion) antes de permitir otro.
// Las filas viejas no se borran automaticamente (no hay cron todavia) pero
// pesan poco y no afectan la logica, solo ocupan espacio con el tiempo.
model AuthAttempt {
  id        String   @id @default(cuid())
  identifier String  // email o ip, segun lo que se este limitando
  action    String   // "login" | "register" | "password-reset-request"
  createdAt DateTime @default(now())

  @@index([identifier, action, createdAt])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  fullName   String
  street     String
  city       String
  postalCode String
  province   String
  country    String
  phone      String
  isDefault  Boolean @default(false)

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  // Interruptor del Panel Admin (menú superior/inferior y home): true =
  // visible en navbar/footer/"Categorías destacadas"; false = archivada,
  // pero su ruta de catálogo y sus productos siguen existiendo igual.
  active   Boolean   @default(true)
  // Dos fotos independientes subidas desde /admin/categorias (Cloudinary),
  // cada una con su relación de aspecto — usar la misma foto para ambas se
  // veía mal porque una tarjeta es vertical (3:4) y el banner es horizontal
  // panorámico (~2.4:1).
  // coverImage: tarjeta "Categorías destacadas" del home. Si es null, cae a
  // la imagen curada de lib/categories.ts.
  coverImageUrl      String?
  coverImagePublicId String?
  // Ancho/alto reales del archivo (Cloudinary los devuelve al subir) — hace
  // falta la relación de aspecto real para calcular bien el zoom/encuadre
  // vía background-size/background-position (ver lib/image-framing.ts).
  // object-fit + transform:scale NO sirve para esto: el recorte se decide
  // antes del transform, así que el zoom solo amplía lo ya recortado y
  // mover la posición nunca revela contenido nuevo — bug real detectado en
  // producción, confirmado con una prueba CSS aislada sin código propio.
  coverImageWidth  Int?
  coverImageHeight Int?
  // Encuadre editable desde /admin/categorias (arrastrar + zoom) sin volver
  // a subir el archivo: posX/posY son el background-position en % (50/50 =
  // centrado) y zoom es un factor de escala (1 = sin zoom, ya cubriendo el
  // marco).
  coverImagePosX Float @default(50)
  coverImagePosY Float @default(50)
  coverImageZoom Float @default(1)
  // coverVideo: loop opcional que reemplaza la foto fija de la tarjeta del
  // home (Sprint 22) — mismo mecanismo que Settings.heroVideoUrl, pero por
  // categoría. Sin video, la tarjeta sigue usando coverImage como siempre;
  // con video, coverImage pasa a ser el poster (se ve mientras carga). No
  // necesita ancho/alto/posX/posY/zoom: a diferencia de las fotos, el video
  // se sirve a pantalla completa vía object-fit:cover sin encuadre ajustable.
  coverVideoUrl      String?
  coverVideoPublicId String?
  // bannerImage: banner grande al entrar a la colección (/[slug]). Si es
  // null, cae al arte decorativo (PlaceholderArt).
  bannerImageUrl      String?
  bannerImagePublicId String?
  bannerImageWidth  Int?
  bannerImageHeight Int?
  bannerImagePosX Float @default(50)
  bannerImagePosY Float @default(50)
  bannerImageZoom Float @default(1)
  // bannerVideo: mismo mecanismo que coverVideo pero para el banner de
  // colección (/[slug]) — bannerImage pasa a ser el poster mientras carga
  // o si se quita el video. Sin encuadre ajustable, mismo motivo.
  bannerVideoUrl      String?
  bannerVideoPublicId String?
  // Descuento de la colección completa (0-100, 0 = sin descuento). Se aplica
  // a todos los productos de la categoría que no tengan su propio descuento
  // (>0) — ver lib/pricing/discount.ts. Pierde contra el descuento propio de
  // un producto, gana sobre el descuento del sitio completo.
  discountPercent Int @default(0)
  products Product[]
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  priceValue   Int // centavos
  // Descuento propio del producto (0-100, 0 = sin descuento propio). Gana
  // sobre el descuento de la categoría y el del sitio completo — ver
  // lib/pricing/discount.ts (resolveDiscountPercent). Nunca se acumulan.
  discountPercent Int @default(0)
  color        String
  description  String
  featured     Boolean          @default(false)
  // true = visible en catálogo/búsqueda/destacados. Se pone en false
  // automáticamente cuando un admin intenta "eliminar" un producto que ya
  // tiene pedidos/carritos/favoritos asociados (no se puede borrar sin
  // romper el historial) — ver deleteProductAction.
  active       Boolean          @default(true)
  images       ProductImage[]
  variants     ProductVariant[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // SKU único (Sprint 19) — nullable para no romper productos existentes al
  // migrar; un backfill lo completa para todos los productos ya creados y
  // desde entonces siempre viene con valor (autogenerado si el admin lo
  // deja vacío).
  sku String? @unique

  // Contador de vistas reales (incrementado atómicamente, máximo una vez
  // por visitante/sesión — ver lib/catalog/view-actions.ts) y "vistas
  // promocionales" opcionales que el admin suma manualmente sin tocar el
  // conteo real. Lo que ve el cliente es realViews + promotionalViews.
  realViews        Int             @default(0)
  promotionalViews Int             @default(0)
  showViews        Boolean         @default(true)
  viewers          ProductViewer[]

  backInStockRequests BackInStockRequest[]

  @@index([categoryId])
}

// "Personas viendo esto ahora" (Sprint 19): presencia real, no inventada —
// cada pestaña abierta manda un latido cada ~20s (ver
// lib/catalog/presence-actions.ts); se cuenta como "activo" a quien
// mandó un latido en el último minuto. Fila por producto+sesión, se
// limpia sola con el tiempo (no hay job de borrado, las filas viejas
// simplemente dejan de contar y se pisan en el próximo latido de esa
// sesión).
model ProductViewer {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionId  String
  lastSeenAt DateTime @updatedAt

  @@unique([productId, sessionId])
  @@index([productId, lastSeenAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // public_id de Cloudinary (Sprint 15) — null para imágenes sembradas desde
  // Unsplash (lib/placeholder-data.ts), que no viven en Cloudinary y por lo
  // tanto no deben intentar borrarse ahí. Solo las imágenes subidas desde el
  // Panel Administrativo tienen publicId.
  publicId  String?
  position  Int

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

enum BackInStockStatus {
  PENDING
  NOTIFIED
  FAILED
}

// "Avísame cuando vuelva" (Fase 2, prioridad P2): una solicitud real por
// producto+talla+correo — el color no es un campo aparte porque en este
// catálogo cada Product ya tiene un solo color propio (Product.color); la
// "variante" pedida por la fundadora es siempre producto+talla, que es
// exactamente lo que ya modela ProductVariant.
//
// Dos disparadores reales de notificación, ambos cuando ProductVariant.stock
// pasa de 0 a > 0 (revisado en la validación final de P2):
// - updateVariantStockAction (lib/admin/inventory-actions.ts) — reposición
//   manual del admin.
// - releaseReservedStock (lib/checkout/server-order-totals.ts) — un pago
//   reservado que falla/se cancela/vence devuelve stock al MISMO contador
//   que ve la tienda (reserveStock lo descuenta ahí mismo, antes de cobrar;
//   no existe un "pool" de reservas aparte). Si esa era la última unidad,
//   la talla queda de verdad comprable por la siguiente clienta — no es una
//   devolución transitoria ambigua, es el mismo criterio de disponibilidad
//   que usa todo el resto del sitio. Ver el comentario completo en
//   releaseReservedStock.
//
// Anti-duplicados mientras la solicitud sigue activa: índice único parcial
// (productId, size, email) WHERE status = 'PENDING', agregado a mano en la
// migración SQL (Prisma no expresa "unique parcial" en este DSL) — permite
// que la misma persona pida un aviso nuevo si esa talla se agota otra vez
// en el futuro, sin perder el historial de la solicitud anterior (ya
// NOTIFIED o FAILED).
model BackInStockRequest {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  email     String
  // Solo si tenía sesión iniciada al pedirlo; SetNull (no Cascade) porque el
  // dato de demanda por producto+talla sigue siendo útil para decidir qué
  // reponer aunque la cuenta que lo pidió se borre después.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status     BackInStockStatus @default(PENDING)
  notifiedAt DateTime?
  // Mensaje de error seguro para diagnóstico (nunca la respuesta cruda de
  // Resend, que podría traer datos sensibles) — ver
  // lib/email/back-in-stock-notifications.ts.
  failReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, size, status])
  @@index([email])
}

// Mismo patrón "contenedor + items" que Cart/CartItem: Wishlist.id se
// reutiliza como identificador de invitado (cookie `lago-wishlist-id`)
// cuando userId es null, así la wishlist funciona sin sesión igual que
// antes (localStorage, Sprint 6) — ahora persistida en Postgres.
model Wishlist {
  id        String         @id @default(cuid())
  userId    String?        @unique
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique // null = carrito de invitado, identificado por cookie; un solo carrito por cuenta
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  size      String
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId, size])
}

model Order {
  id              String         @id @default(cuid())
  // Correlativo corto para hablar del pedido con la clienta y en el email
  // administrativo ("Pedido #1058") — el id cuid sigue siendo la clave real,
  // esto es solo una etiqueta legible. Empieza en 1000 para que nunca se vea
  // como un pedido de una sola cifra (más prolijo en las primeras ventas).
  orderNumber     Int            @unique @default(autoincrement())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PROCESANDO)
  // Estado logístico (Sprint 30) — deliberadamente separado de
  // Payment.status (que responde "¿se cobró?") y del `status` de arriba
  // (histórico, ya no se expone en el panel). Este es el que se muestra y
  // edita en /admin/pedidos: dónde está el pedido en el proceso de
  // preparar/contactar/coordinar/despachar/entregar, independiente de si el
  // pago fue con tarjeta (Wompi) o coordinado por WhatsApp.
  fulfillmentStatus     FulfillmentStatus @default(PENDIENTE_POR_PREPARAR)
  fulfillmentHistory    OrderStatusEvent[]
  items           OrderItem[]
  payment         Payment?
  subtotal        Int // centavos
  shippingCost    Int // centavos
  tax             Int // centavos
  total           Int // centavos
  // Cupón aplicado (Sprint 17) — opcional, no rompe pedidos anteriores.
  couponCode      String?
  discountValue   Int            @default(0) // centavos, ya restado de `total`
  shippingMethod  ShippingMethod @default(STANDARD)
  shippingAddress Json
  createdAt       DateTime       @default(now())

  @@index([userId])
}

enum OrderStatus {
  PROCESANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  PENDIENTE_PAGO
}

// Estados del PEDIDO (logística/despacho) — a propósito distintos de
// PaymentStatus (que responde solo "¿se cobró?"). Ver comentario en Order.
enum FulfillmentStatus {
  PENDIENTE_POR_PREPARAR
  PREPARANDO
  CLIENTE_CONTACTADO
  ENTREGA_COORDINADA
  DESPACHADO
  ENTREGADO
  CANCELADO
  REEMBOLSADO
}

// Historial de cambios de estado logístico de un pedido (Sprint 30) — para
// que el panel de detalle del pedido pueda mostrar cuándo pasó de
// "Preparando" a "Despachado", etc., y quién lo cambió.
model OrderStatusEvent {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    FulfillmentStatus
  changedByEmail String?
  createdAt DateTime          @default(now())

  @@index([orderId, createdAt])
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  image      String
  size       String
  quantity   Int
  priceValue Int // centavos, snapshot al momento de la compra
  sku        String? // snapshot del SKU al momento de la compra (Sprint 19)
  // color/collection (Sprint 30): snapshot igual que name/image/sku — para
  // que el email de pedido nuevo y el detalle admin puedan mostrar qué
  // color y qué colección se vendió, sin tener que volver a mirar el
  // catálogo (que puede cambiar después).
  color      String?
  collection String?

  @@index([orderId])
}

// Auditoría de seguridad (Sprint 29): providerRef es la referencia que
// nosotros generamos (wompiGateway.createIntent) y que Wompi devuelve tal
// cual en cada evento de webhook — @unique cierra la puerta a que dos
// Payment (y por lo tanto dos Order) terminen asociados a la misma
// transacción real por un webhook duplicado o un doble submit del checkout.
// reservedItems/stockReleased implementan reserva-al-cobrar/liberación-al-
// fallar de inventario (ver lib/checkout/server-order-totals.ts): el stock
// se descuenta atómicamente ANTES de cobrarle la tarjeta al cliente (no
// después, como antes — antes nunca se descontaba en ningún punto), y si el
// cobro falla/se cancela se repone leyendo este snapshot, no lo que mande
// el cliente. lastEventTimestamp guarda el `timestamp` del último evento de
// Wompi aplicado, para rechazar un webhook viejo/repetido que llegue fuera
// de orden (ver app/api/webhooks/wompi/route.ts).
model Payment {
  id                 String          @id @default(cuid())
  orderId            String?         @unique
  order              Order?          @relation(fields: [orderId], references: [id])
  provider           PaymentProvider
  providerRef        String          @unique
  cardLast4          String?
  amount             Int // centavos
  currency           String          @default("COP")
  status             PaymentStatus   @default(PENDING)
  failureReason      String?
  reservedItems       Json?
  stockReleased       Boolean         @default(false)
  lastEventTimestamp  Int?
  // Cupón ya validado server-side al crear el intent (ver
  // reserveAndPriceCheckout) — createOrderAction lo usa para saber qué
  // cupón incrementar, en vez de confiar en lo que vuelva a mandar el
  // cliente en ese segundo paso.
  couponCode          String?
  // Idempotencia del "inicio" del pago con el Checkout Web alojado de Wompi
  // (propuesta/checkout-wompi-alojado): lo genera el navegador una sola vez
  // por carrito (crypto.randomUUID) y lo guarda en sessionStorage, así
  // sobrevive un refresh de la misma pestaña. Es @unique a propósito: la
  // garantía de "un solo intento vigente por checkout" la da el índice
  // único de Postgres, no un findFirst previo — dos clics simultáneos
  // hacen que el segundo INSERT falle con P2002 y reuse el intento que ya
  // existe, en vez de reservar el stock dos veces y crear dos Payment (ver
  // startWompiHostedCheckoutAction en lib/payments/payments-actions.ts).
  // Nullable porque los pagos viejos, los de WhatsApp y los del proveedor
  // simulado no tienen ninguno (Postgres permite muchos NULL en un índice
  // único).
  checkoutAttemptId   String?         @unique
  // Snapshot server-side de lo que falta para crear el pedido cuando la
  // clienta vuelva de Wompi: items del carrito, dirección de envío, método
  // de envío, y si pidió guardar la dirección / suscribirse al newsletter
  // (ver PendingOrderInput en lib/checkout/pending-order.ts). Mismo patrón
  // que `reservedItems`: un Json snapshot escrito en el mismo paso en que
  // se crea el intent.
  //
  // Vive en la base de datos, y no solo en sessionStorage del navegador,
  // porque el navegador puede no volver nunca (cierra la pestaña después de
  // pagar, vuelve en otro dispositivo, se le corta la red). Un proceso
  // server-side —el cron que verifica pagos vencidos contra Wompi— puede
  // así "recuperar" un pago realmente APPROVED del que nunca llegó ni el
  // webhook ni el regreso del navegador, y crear el pedido igual. Nunca
  // guarda datos de tarjeta: parsePendingOrderInput descarta cualquier
  // campo que no sea uno de los de arriba.
  pendingOrderInput   Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum PaymentProvider {
  STRIPE
  WOMPI
  WHATSAPP
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  // No hay flujo de reembolso automático todavía (se coordina a mano) — el
  // valor existe para que un admin pueda marcarlo y quede reflejado en
  // estadísticas/email, sin que nada del código lo dispare solo.
  REFUNDED
}

// Sprint 17 — Marketing e Inteligencia

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String // Markdown simple, renderizado con lib/blog/markdown.ts
  coverImage  String
  tags        String[] @default([])
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorName  String   @default("Equipo LAGO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model NewsletterCampaign {
  id        String         @id @default(cuid())
  subject   String
  body      String
  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  sentAt    DateTime?
}

enum CampaignStatus {
  DRAFT
  SENT
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  // Porcentaje (0-100) si type = PERCENTAGE; centavos si type = FIXED.
  value       Int
  active      Boolean    @default(true)
  minSubtotal Int        @default(0) // centavos
  maxUses     Int?
  usedCount   Int        @default(0)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// Fila única (Sprint 18) con configuración regional/moneda editable desde
// el panel — evita repetir la tasa COP/USD o el país por defecto como
// literales sueltos en varios componentes. id fijo ("singleton") en vez de
// una tabla de una sola fila con id autogenerado: hace explícito que solo
// debe existir un registro.
model Settings {
  id              String   @id @default("singleton")
  defaultCountry  String   @default("Colombia")
  defaultCurrency String   @default("COP")
  usdRate         Float    @default(4000) // pesos COP por 1 USD
  // "trm": se actualiza sola contra la TRM oficial de Colombia (datos.gov.co)
  // cada vez que se lee y quedó desactualizada; "manual": el admin fijó un
  // valor a mano y no se vuelve a tocar solo.
  usdRateSource   String   @default("trm")

  // Descuento de todo el sitio (0-100, 0 = sin descuento). Último nivel de
  // la cascada producto > categoría > sitio — ver lib/pricing/discount.ts.
  discountPercent Int @default(0)

  // Envío gratis desde este monto (COP), sobre el subtotal de productos ya
  // con el cupón aplicado (Sprint 28) — no hay tarifario de envío por
  // ciudad todavía, así que por debajo de este monto el checkout nunca
  // inventa un costo: muestra "Por confirmar" (ver lib/checkout/pricing.ts
  // y components/checkout/cost-summary.tsx).
  freeShippingThreshold Int @default(299900)

  // Guía de tallas única para toda la tienda (Sprint 20): antes se subía
  // como una foto más dentro de la galería de cada producto, lo que se
  // veía mal mezclada con las fotos reales de la prenda. Una sola imagen
  // reutilizada en todos los productos vía el botón "Guía de tallas" junto
  // al selector de talla — sin framing/zoom porque es una tabla de
  // referencia que se muestra completa, no una foto de moda para recortar.
  sizeGuideImageUrl      String?
  sizeGuideImagePublicId String?
  sizeGuideImageWidth    Int?
  sizeGuideImageHeight   Int?

  // Portada del home con video (Sprint 21): reemplaza el fondo estático de
  // manchas pastel por un video corto en loop que la fundadora sube y
  // cambia ella misma desde /admin/configuracion para destacar la colección
  // del momento — sin video subido, el Hero cae al diseño anterior (texto +
  // fondo animado con CSS), igual que la guía de tallas antes de subirse.
  // heroPoster es la imagen que se ve mientras el video carga o si el
  // navegador no puede reproducirlo — nunca queda en blanco.
  heroVideoUrl        String?
  heroVideoPublicId   String?
  heroPosterUrl       String?
  heroPosterPublicId  String?
  heroPosterWidth     Int?
  heroPosterHeight    Int?
  // Texto editable superpuesto — todos opcionales; el componente cae al
  // texto de marca actual si están vacíos.
  heroEyebrow    String?
  heroHeadline   String?
  heroSubheadline String?
  heroCtaLabel   String?
  heroCtaHref    String?

  updatedAt       DateTime @updatedAt
}
